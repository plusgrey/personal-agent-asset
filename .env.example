# Copy to your shell environment; never commit real values.
AGENT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Set when AGENT_PROVIDER=command. The prompt is provided on stdin.
EXTERNAL_AGENT_COMMAND=
NOTION_TOKEN=
NOTION_PAGE_ID=38889a37c8408030b9bdcdbd13c618d9
NOTION_VERSION=2026-03-11
# Required for live quant-interview runs because private Notion text is sent to the selected provider.
ALLOW_PRIVATE_CONTEXT=false
AGENT_LOCALE=en
AUTOMATION_STATE_DIR=automations/state
# Optional generic JSON webhook receiving {"title": ..., "body": ...}.
NOTIFICATION_WEBHOOK_URL=
